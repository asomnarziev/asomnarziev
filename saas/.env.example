# ============================================================================
#  PBX -> Telegram: sozlamalar. Nusxa oling:  cp .env.example .env
#  Maxfiy qiymatlarni yarating:  openssl rand -hex 32
#  .env faylini hech qachon git'ga qo'shmang (.gitignore'da turibdi).
# ============================================================================

# ---- Majburiy ----
DATABASE_URL=postgresql+psycopg2://pbxbot:PAROL@localhost/pbxbot
BASE_URL=https://pbx.atcpbx.uz
# Sessiya imzosi va OnlinePBX kalitlarini shifrlash uchun. O'zgartirsangiz, saqlangan PBX kalitlar o'qilmay qoladi!
SECRET_KEY=
BOT_TOKEN=
BOT_USERNAME=my_pbx_bot
TG_WEBHOOK_SECRET=

# ---- To'lov (kartaga o'tkazma) ----
PAYMENT_CARD=
PAYMENT_CARD_HOLDER=
# To'lov eslatmalari keladigan SHAXSIY chat ID (botga /id yozing)
ADMIN_CHAT_ID=
MAX_RECEIPT_MB=8

# ---- Zaxira (har kuni 23:59 da adminning Telegramiga, ADMIN_CHAT_ID ga) ----
# Telegramga FAQAT shifrlab yuboriladi. Parolni yarating:  openssl rand -base64 24
# MUHIM: parolni .env dan TASHQARIDA ham saqlang (parol menejer); server yo'qolsa, usiz zaxirani ochib bo'lmaydi.
BACKUP_PASSPHRASE=
# Serverda nechta eng yangi nusxa saqlansin (eskilari o'chiriladi)
BACKUP_KEEP=1

# ---- Kirish sahifasidagi administrator kontaktlari ----
CONTACT_TELEGRAM=asom_narziev
CONTACT_PHONE=+998948302407
CONTACT_EMAIL=asomnarziev07@gmail.com

# ---- Ixtiyoriy (qiymatlar - standart) ----
TRIAL_DAYS=7
TZ_OFFSET_HOURS=5
LOG_LEVEL=INFO
SCHEDULER=1
MAX_CALLS_PER_DAY=5000
MAX_RECORD_FETCH_PER_HOUR=60

# ---- OnlinePBX API limitlaridan himoya ----
PBX_RPS_PER_TENANT=2
PBX_RPS_GLOBAL=10
PBX_MAX_RETRIES=3
PBX_KEY_TTL=21600
PBX_AUTH_COOLDOWN=300
